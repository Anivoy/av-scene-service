model Prefecture {
  id   String @id @default(uuid())
  name String @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  scenes Scene[]
  cities City[]

  region   Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  regionId String

  @@map("prefectures")
}
